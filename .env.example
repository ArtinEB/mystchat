# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram Bot Username (without @)
TELEGRAM_BOT_USERNAME=YourHiddenBot

# Strong secret key used for token encryption (at least 32 characters or random 64-char hex)
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_SECRET=change_this_to_a_secure_random_64_character_hex_secret_key_123456

# Optional: Webhook secret token for validating incoming Telegram updates
WEBHOOK_SECRET=your_optional_webhook_secret_token

